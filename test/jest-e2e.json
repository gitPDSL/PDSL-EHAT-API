{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^googleapis$": "<rootDir>/helpers/googleapis-mock.ts"
  },
  "setupFiles": ["./helpers/env-setup.ts"],
  "maxWorkers": 1
}
