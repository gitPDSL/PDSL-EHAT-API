NODE_ENV=test
TYPEORM_ALLOW_SCHEMA_SYNC=true

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=ehat_test
DATABASE_PASSWORD=ehat_test
DATABASE_NAME=ehat_test
DATABASE_LOG=false

APP_NAME=eHAT Test
APP_URL=http://localhost:3000
APP_PORT=3000
APP_AUTH_KEY=test
SUPPORT_EMAIL=test@example.com
NO_REPLY=noreply@example.com

JWT_ACCESS_SECRET=test-access-secret-do-not-use-in-prod
JWT_ACCESS_EXPIRE_TIME=15m
JWT_REFRESH_EXPIRE_TIME=7d
JWT_EXPIRE_TIME=15m

# SMTP values are ignored in tests — MailerService is mocked.
SMTP_SERVICE=gmail
SMTP_CLIENT_ID=test
SMTP_CLIENT_SECRET=test
SMTP_REFRESH_TOKEN=test
SMTP_EMAIL_USER=test@example.com
