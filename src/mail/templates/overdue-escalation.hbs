<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Overdue timesheet approvals</title>
  <style>
    .container { max-width: 600px; margin: auto; font-family: Arial, sans-serif; padding: 20px; border: 1px solid #eee; border-radius: 8px; color: #333; }
    .button { display: inline-block; background-color: #dc3545; color: #fff !important; padding: 12px 20px; text-decoration: none; border-radius: 5px; margin-top: 20px; font-weight: bold; }
    table { width: 100%; border-collapse: collapse; margin: 16px 0; }
    th, td { border: 1px solid #eee; padding: 8px; text-align: left; font-size: 13px; }
    th { background-color: #f7f7f7; }
    .footer { margin-top: 30px; font-size: 12px; color: #888; }
    p { line-height: 1.6; font-size: 14px; margin: 10px 0; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Hello {{managerName}},</h2>
    <p>The following timesheets have been submitted but are still awaiting your approval for more than 2 business days:</p>
    <table>
      <thead>
        <tr><th>Employee</th><th>Week</th><th>Days overdue</th></tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td>{{this.employeeName}}</td>
          <td>{{this.weekNumber}}</td>
          <td>{{this.daysOverdue}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    <a href="{{link}}" class="button">Open approvals</a>
    <div class="footer">
      <p>Sent by {{appName}}</p>
    </div>
  </div>
</body>
</html>
