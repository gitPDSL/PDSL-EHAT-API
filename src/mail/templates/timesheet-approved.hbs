<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Timesheet approved</title>
  <style>
    .container { max-width: 600px; margin: auto; font-family: Arial, sans-serif; padding: 20px; border: 1px solid #eee; border-radius: 8px; color: #333; }
    .footer { margin-top: 30px; font-size: 12px; color: #888; }
    p { line-height: 1.6; font-size: 14px; margin: 10px 0; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Hello {{employeeName}},</h2>
    <p>Your timesheet for week {{weekNumber}} of {{year}} has been <strong>approved</strong> by {{approverName}}.</p>
    <p>No further action is needed on your side.</p>
    <div class="footer">
      <p>Sent by {{appName}}</p>
    </div>
  </div>
</body>
</html>
