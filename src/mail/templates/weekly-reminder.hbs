<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Timesheet reminder</title>
  <style>
    .container { max-width: 600px; margin: auto; font-family: Arial, sans-serif; padding: 20px; border: 1px solid #eee; border-radius: 8px; color: #333; }
    .button { display: inline-block; background-color: #007bff; color: #fff !important; padding: 12px 20px; text-decoration: none; border-radius: 5px; margin-top: 20px; font-weight: bold; }
    ul { padding-left: 20px; }
    .footer { margin-top: 30px; font-size: 12px; color: #888; }
    p { line-height: 1.6; font-size: 14px; margin: 10px 0; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Hello {{employeeName}},</h2>
    <p>Friendly reminder that you still have weekday entries missing on this week's timesheet:</p>
    <ul>
      {{#each missingDays}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
    <p>Please log your hours before the week closes.</p>
    <a href="{{link}}" class="button">Open timesheet</a>
    <div class="footer">
      <p>Sent by {{appName}}</p>
    </div>
  </div>
</body>
</html>
