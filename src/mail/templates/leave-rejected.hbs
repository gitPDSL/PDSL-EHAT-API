<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Leave request rejected</title>
  <style>
    .container { max-width: 600px; margin: auto; font-family: Arial, sans-serif; padding: 20px; border: 1px solid #eee; border-radius: 8px; color: #333; }
    .reason { background-color: #fff8f8; border-left: 4px solid #dc3545; padding: 12px 16px; margin: 16px 0; }
    .footer { margin-top: 30px; font-size: 12px; color: #888; }
    p { line-height: 1.6; font-size: 14px; margin: 10px 0; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Hello {{employeeName}},</h2>
    <p>Your {{leaveTypeName}} leave request from <strong>{{startDate}}</strong> to <strong>{{endDate}}</strong> has been <strong>rejected</strong>.</p>
    {{#if reason}}
    <div class="reason">
      <strong>Reason:</strong>
      <p>{{reason}}</p>
    </div>
    {{/if}}
    <div class="footer">
      <p>Sent by {{appName}}</p>
    </div>
  </div>
</body>
</html>
